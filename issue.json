":"5319e7","default":false,"description":"Issue has received an initial automated triage pass."},{"id":10900935756,"node_id":"LA_kwDOSYIPIM8AAAACib8UTA","url":"https://api.github.com/repos/warpdotdev-demos/warp-copy/labels/repro:medium","name":"repro:medium","color":"fbca04","default":false,"description":"The report suggests a plausible repro path, but some uncertainty remains."},{"id":10901023924,"node_id":"LA_kwDOSYIPIM8AAAACicBstA","url":"https://api.github.com/repos/warpdotdev-demos/warp-copy/labels/area:workspace","name":"area:workspace","color":"0550ae","default":false,"description":"File tree, workspace navigation, project switching, and working-directory management."}],"state":"open","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-05-11T15:30:42Z","updated_at":"2026-07-14T22:34:54Z","closed_at":null,"assignee":null,"author_association":"COLLABORATOR","issue_field_values":[],"type":null,"active_lock_reason":null,"sub_issues_summary":{"total":0,"completed":0,"percent_completed":0},"issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"### What happened?\n\nThe Project Explorer sometimes stays stale after creating directories from the terminal. The new folders exist on disk and are visible after reopening the workspace, but the explorer tree does not update automatically.\n\n### Steps to reproduce\n\n1. Open a repository in Warp with Project Explorer visible.\n2. Run `mkdir -p tmp/demo/nested` from a terminal block.\n3. Look at the Project Explorer tree.\n4. Collapse and expand the parent folder.\n\n### Expected behavior\n\nThe `tmp/demo/nested` path should appear without needing to restart Warp or reopen the project.\n\n### Actual behavior\n\nThe tree remains unchanged. In some cases, collapsing and expanding the parent folder still does not show the new directory.\n\n### Workaround\n\nClosing and reopening the workspace refreshes the tree, but that is disruptive when actively editing files.","closed_by":null,"reactions":{"url":"https://api.github.com/repos/warpdotdev-demos/warp-copy/issues/8/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/warpdotdev-demos/warp-copy/issues/8/timeline","performed_via_github_app":null,"state_reason":null,"pinned_comment":null}